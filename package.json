{
  "name": "gold-erp-rate-service",
  "version": "1.0.0",
  "description": "Kur servis: Express 5 + Prisma + TS",
  "type": "module",
  "main": "dist/app/api.js",
  "scripts": {
    "dev": "npm run dev:api & npm run dev:worker",
    "dev:api": "tsx watch src/app/api.ts",
    "dev:worker": "tsx watch src/app/worker.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node --enable-source-maps dist/app/api.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:seed": "tsx --tsconfig tsconfig.json prisma/seed.ts",
    "prisma:setup": "npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed",
    "clean": "rm -rf node_modules",
    "superclean": "npm cache clean --force && rm -rf node_modules package-lock.json",
    "prepare": "husky"
  },
  "keywords": [
    "gold-erp-rate-service",
    "nodejs",
    "typescript",
    "express",
    "prisma"
  ],
  "author": "Gold ERP",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@bull-board/api": "^6.7.4",
    "@bull-board/express": "^6.7.4",
    "bullmq": "^5.70.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "pg": "^8.20.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "prisma": "^7.2.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
